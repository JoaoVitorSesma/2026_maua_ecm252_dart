+-- Executado após o schema original em um volume novo.
+-- Em um banco já existente, aplique este arquivo uma única vez, sem apagar dados.
+ALTER TABLE terrarios ADD COLUMN observacoes VARCHAR(500) NULL;
+
+CREATE TABLE especies (
+  id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
+  nome VARCHAR(120) NOT NULL,
+  PRIMARY KEY (id),
+  UNIQUE KEY uq_especie_nome (nome)
+);
+
+CREATE TABLE terrario_especies (
+  terrario_id INT UNSIGNED NOT NULL,
+  especie_id BIGINT UNSIGNED NOT NULL,
+  PRIMARY KEY (terrario_id, especie_id),
+  CONSTRAINT fk_te_terrario FOREIGN KEY (terrario_id)
+    REFERENCES terrarios (id) ON DELETE CASCADE,
+  CONSTRAINT fk_te_especie FOREIGN KEY (especie_id)
+    REFERENCES especies (id) ON DELETE CASCADE
+);
+
+INSERT INTO especies (nome) VALUES ('Samambaia'), ('Musgo');
+INSERT INTO terrario_especies (terrario_id, especie_id) VALUES (1, 1), (3, 2);
