+import 'dart:convert';
+import 'dart:io';
+
+import 'package:shelf/shelf_io.dart' as shelf_io;
+import 'package:terrario_api/src/api.dart';
+import 'package:terrario_api/src/config/app_config.dart';
+import 'package:terrario_api/src/config/database.dart';
+import 'package:test/test.dart';
+
+import 'terrario_service_test.dart' show RepositorioFake;
+
+const config = AppConfig(
+  appEnv: 'production',
+  serverPort: 8080,
+  logLevel: 'info',
+  dbHost: '127.0.0.1',
+  dbPort: 3307,
+  dbName: 'terrarios',
+  dbUser: 'teste',
+  dbPassword: 'teste',
+  dbPoolSize: 1,
+);
+
+void main() {
+  late HttpServer servidor;
+  late HttpClient cliente;
+  late Future<void> Function() fecharPool;
+
+  setUp(() async {
+    final pool = criarPool(config);
+    fecharPool = pool.close;
+    servidor = await shelf_io.serve(
+      construirApi(config, pool, repository: RepositorioFake()),
+      InternetAddress.loopbackIPv4,
+      0,
+    );
+    cliente = HttpClient();
+  });
+
+  tearDown(() async {
+    cliente.close(force: true);
+    await servidor.close(force: true);
+    await fecharPool();
+  });
+
+  Future<({int status, HttpHeaders headers, String body})> enviar(
+    String metodo,
+    String caminho, {
+    Object? corpo,
+    String? requestId,
+  }) async {
+    final requisicao = await cliente.openUrl(
+      metodo,
+      Uri.parse('http://127.0.0.1:${servidor.port}$caminho'),
+    );
+    if (requestId != null) requisicao.headers.set('X-Request-Id', requestId);
+    if (corpo != null) {
+      requisicao.headers.contentType = ContentType.json;
+      requisicao.write(jsonEncode(corpo));
+    }
+    final resposta = await requisicao.close();
+    return (
+      status: resposta.statusCode,
+      headers: resposta.headers,
+      body: await utf8.decoder.bind(resposta).join(),
+    );
+  }
+
+  Map<String, dynamic> dados({String apelido = 'Terrario de teste'}) => {
+    'apelido': apelido,
+    'bioma': 'musgo',
+    'umidadeAlvo': 80,
+    'volumeLitros': 5.0,
+    'dataMontagem': '2020-01-01',
+    'observacoes': 'Manter na sombra.',
+  };
+
+  test('cria, consulta, altera parcialmente e remove por HTTP', () async {
+    final criacao = await enviar('POST', '/api/v1/terrarios', corpo: dados());
+    expect(criacao.status, 201);
+    expect(criacao.headers.value('location'), '/api/v1/terrarios/1');
+    final criado = jsonDecode(criacao.body) as Map<String, dynamic>;
+    expect(criado['observacoes'], 'Manter na sombra.');
+    expect(criado['_links'], contains('self'));
+
+    final alteracao = await enviar(
+      'PATCH',
+      '/api/v1/terrarios/1',
+      corpo: {'umidadeAlvo': 70, 'observacoes': null},
+    );
+    expect(alteracao.status, 200);
+    final atualizado = jsonDecode(alteracao.body) as Map<String, dynamic>;
+    expect(atualizado['apelido'], 'Terrario de teste');
+    expect(atualizado['umidadeAlvo'], 70);
+    expect(atualizado['observacoes'], isNull);
+    expect(atualizado['_links'], contains('self'));
+
+    final consulta = await enviar('GET', '/api/v1/terrarios/1');
+    expect(consulta.status, 200);
+    expect(jsonDecode(consulta.body), atualizado);
+
+    final remocao = await enviar('DELETE', '/api/v1/terrarios/1');
+    expect(remocao.status, 204);
+    expect(remocao.body, isEmpty);
+    expect((await enviar('GET', '/api/v1/terrarios/1')).status, 404);
+  });
+
+  test('valida observacoes e recusa apelido duplicado', () async {
+    final invalido = dados()..['observacoes'] = 'a' * 501;
+    final falha = await enviar('POST', '/api/v1/terrarios', corpo: invalido);
+    expect(falha.status, 422);
+    expect(falha.headers.contentType!.mimeType, 'application/problem+json');
+    expect((jsonDecode(falha.body) as Map)['errors'], contains('observacoes'));
+    expect(
+      (await enviar('POST', '/api/v1/terrarios', corpo: dados())).status,
+      201,
+    );
+    expect(
+      (await enviar('POST', '/api/v1/terrarios', corpo: dados())).status,
+      409,
+    );
+  });
+
+  test(
+    'ordena a colecao, preserva filtros nos links e recusa SQL na ordenacao',
+    () async {
+      await enviar('POST', '/api/v1/terrarios', corpo: dados(apelido: 'Alfa'));
+      await enviar('POST', '/api/v1/terrarios', corpo: dados(apelido: 'Zeta'));
+      final resposta = await enviar(
+        'GET',
+        '/api/v1/terrarios?ordenarPor=apelido:desc&tamanhoPagina=1',
+      );
+      expect(resposta.status, 200);
+      final pagina = jsonDecode(resposta.body) as Map<String, dynamic>;
+      expect((pagina['itens'] as List).first['apelido'], 'Zeta');
+      final links = pagina['_links'] as Map;
+      final href = (links['next'] as Map)['href'] as String;
+      expect(Uri.parse(href).queryParameters['ordenarPor'], 'apelido:desc');
+      expect(
+        (await enviar('GET', '/api/v1/terrarios?ordenarPor=DROP')).status,
+        422,
+      );
+    },
+  );
+
+  test('expoe a entrada da API, especies e documentacao', () async {
+    final entrada = await enviar('GET', '/api/v1');
+    expect(entrada.status, 200);
+    expect((jsonDecode(entrada.body) as Map).keys, ['_links']);
+    expect(
+      (jsonDecode(entrada.body) as Map)['_links'],
+      containsPair('terrarios', {'href': '/api/v1/terrarios', 'method': 'GET'}),
+    );
+    final criado = await enviar('POST', '/api/v1/terrarios', corpo: dados());
+    expect((jsonDecode(criado.body) as Map)['_links'], contains('especies'));
+    final especies = await enviar('GET', '/api/v1/terrarios/1/especies');
+    expect(especies.status, 200);
+    expect((jsonDecode(especies.body) as Map)['itens'], isEmpty);
+    expect((await enviar('GET', '/api/v1/terrarios/999/especies')).status, 404);
+    final docs = await enviar('GET', '/docs/');
+    expect(docs.status, 200);
+    expect(docs.body, contains("url: '/docs/openapi.yaml'"));
+    expect((await enviar('GET', '/docs/openapi.yaml')).status, 200);
+    expect((await enviar('GET', '/health/live')).status, 200);
+  });
+
+  test('propaga X-Request-Id e gera um identificador quando ausente', () async {
+    final resposta = await enviar('GET', '/api/v1', requestId: 'aula-252');
+    expect(resposta.headers.value('x-request-id'), 'aula-252');
+    final outra = await enviar('GET', '/api/v1');
+    expect(
+      outra.headers.value('x-request-id'),
+      matches(RegExp(r'^[a-f0-9]{32}$')),
+    );
+  });
+
+  test('rejeita a requisicao 61 com 429 e Retry-After', () async {
+    for (var i = 0; i < 60; i++) {
+      expect((await enviar('GET', '/api/v1')).status, 200);
+    }
+    final bloqueio = await enviar('GET', '/api/v1');
+    expect(bloqueio.status, 429);
+    expect(
+      int.parse(bloqueio.headers.value('retry-after')!),
+      inInclusiveRange(1, 60),
+    );
+    expect(bloqueio.headers.contentType!.mimeType, 'application/problem+json');
+  });
+}
