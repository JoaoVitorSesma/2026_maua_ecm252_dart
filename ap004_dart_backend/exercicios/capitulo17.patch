+import 'package:terrario_api/src/repositories/mysql_terrario_repository.dart';
+import 'package:terrario_api/src/web/middlewares.dart';
+import 'package:test/test.dart';
+
+/// Simula somente a fronteira com o driver; nenhuma consulta real é executada.
+class PoolComFalha extends MySQLConnectionPool {
+  PoolComFalha(this.codigo)
+    : super(
+        host: '127.0.0.1',
+        port: 3307,
+        userName: 'teste',
+        password: 'teste',
+        maxConnections: 1,
+      );
+
+  final int codigo;
+
+  @override
+  Future<IResultSet> execute(
+    String query, [
+    Map<String, dynamic>? params,
+    bool iterable = false,
+  ]) async => throw MySQLServerException('Falha simulada do banco', codigo);
+}
+
+void main() {
+  final terrario = Terrario(
+    apelido: 'Nome disputado',
+    bioma: Bioma.musgo,
+    umidadeAlvo: 80,
+    volumeLitros: 5,
+    dataMontagem: DateTime.utc(2020),
+  );
+
+  test('traduz 1062 no INSERT em Conflito e resposta HTTP 409', () async {
+    final repository = MySqlTerrarioRepository(PoolComFalha(1062));
+    final handler = const Pipeline()
+        .addMiddleware(tratarErros(detalharFalhas: false))
+        .addHandler((Request _) async {
+          await repository.inserir(terrario);
+          return Response(201);
+        });
+    final resposta = await handler(
+      Request('POST', Uri.parse('http://localhost/')),
+    );
+    expect(resposta.statusCode, 409);
+    expect(
+      resposta.headers['content-type'],
+      startsWith('application/problem+json'),
+    );
+    final corpo = jsonDecode(await resposta.readAsString()) as Map;
+    expect(corpo['status'], 409);
+    expect(corpo['detail'], isNot(contains('Falha simulada')));
+  });
+
+  test('traduz 1062 no UPDATE e preserva outros erros do banco', () async {
+    final repository = MySqlTerrarioRepository(PoolComFalha(1062));
+    await expectLater(
+      repository.atualizar(1, terrario),
+      throwsA(isA<Conflito>()),
+    );
+    final outro = MySqlTerrarioRepository(PoolComFalha(1146));
+    await expectLater(
+      outro.inserir(terrario),
+      throwsA(isA<MySQLServerException>()),
+    );
+  });
+}
