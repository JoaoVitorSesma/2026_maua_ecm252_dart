+
+class _Janela {
+  _Janela(this.inicio);
+
+  final DateTime inicio;
+  int quantidade = 0;
+}
+
+/// Janela fixa de um minuto por endereço real da conexão HTTP.
+/// X-Forwarded-For não é confiado sem um proxy explicitamente configurado.
+Middleware limitarTaxa() {
+  final janelas = <String, _Janela>{};
+  return (Handler proximo) => (Request requisicao) async {
+    final agora = DateTime.now().toUtc();
+    janelas.removeWhere(
+      (_, janela) =>
+          agora.difference(janela.inicio) >= const Duration(minutes: 1),
+    );
+    final conexao =
+        requisicao.context['shelf.io.connection_info'] as HttpConnectionInfo?;
+    final endereco = conexao?.remoteAddress.address ?? 'desconhecido';
+    final janela = janelas.putIfAbsent(endereco, () => _Janela(agora));
+    if (janela.quantidade >= 60) {
+      final restante = 60000 - agora.difference(janela.inicio).inMilliseconds;
+      return problema(
+        status: 429,
+        tipo: 'limite-de-requisicoes',
+        titulo: 'Muitas requisicoes',
+        detalhe: 'Limite de 60 requisicoes por minuto por endereco.',
+      ).change(headers: {'retry-after': '${(restante / 1000).ceil()}'});
+    }
+    janela.quantidade++;
+    return proximo(requisicao);
+  };
+}
